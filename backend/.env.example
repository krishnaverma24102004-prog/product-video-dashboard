# ---- Server ----
PORT=4000
LOG_LEVEL=info

# ---- Vision ("brain") ----
# Free key: https://aistudio.google.com/apikey . Without it the app falls back to keyword
# heuristics + local CLIP scoring only (still works, less accurate, no written reasons).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-latest,gemini-3.5-flash-lite,gemini-flash-lite-latest
GEMINI_RPM=10
CLIP_MODEL=Xenova/clip-vit-base-patch32

# ---- Matching ----
MATCH_THRESHOLD=50
PER_SOURCE_TARGET=20
MAX_QUERY_ROUNDS=8
PHASH_DISTANCE=5

# ---- Instagram (logged-in session) ----
# Preferred: run `npm run ig:login` once; it writes backend/.sessions/ig.json (gitignored).
# Alternative: paste the `sessionid` cookie value from a logged-in browser.
IG_STATE_PATH=
IG_SESSION_ID=
IG_MIN_DELAY_MS=3000
IG_DAILY_PAGE_CAP=250
IG_MAX_SCROLLS=14

# ---- Meta Ad Library (public, no login) ----
META_COUNTRY=ALL
META_MAX_SCROLLS=14

# ---- TikTok (optional bonus source, public web search, no login) ----
# Only used when a search ticks "Include TikTok (beta)". No minimum: shown as found/TIKTOK_TARGET.
TIKTOK_TARGET=10
TIKTOK_MAX_QUERIES=4
TIKTOK_MAX_SCROLLS=8

# ---- Runtime ----
HEADLESS=true
SOURCE_TIMEOUT_MS=120000
QUEUE_CONCURRENCY=1
PRODUCT_CACHE_TTL_HOURS=24

# ---- Search deadline / vision budget ----
# Hard wall-clock limit for one search (ms). No new query rounds start after it, collector calls are
# cut to the time left, and Gemini calls stop (remaining videos are scored CLIP-only).
SEARCH_DEADLINE_MS=240000
# Max Gemini requests one search may make (analysis + judging, all models). Past it: CLIP-only.
GEMINI_MAX_CALLS_PER_SEARCH=24
# Wall-clock cap for ONE Gemini request across the whole model chain (ms). Past it the search continues CLIP-only.
GEMINI_CALL_BUDGET_MS=50000
# A search still running at SEARCH_DEADLINE_MS + this grace (ms) is marked error and its late results are discarded.
SEARCH_WATCHDOG_GRACE_MS=90000

# ---- Network / API security ----
# Interface to bind. 127.0.0.1 = this machine only. Use 0.0.0.0 only inside Docker or if you
# really want LAN access (then also list your LAN host/origin below).
HOST=127.0.0.1
# Browser origins allowed to call the API (CORS + Origin check on POST/DELETE). Comma-separated.
# Empty = http://localhost:5173, http://127.0.0.1:5173, http://localhost:<PORT>, http://127.0.0.1:<PORT>
ALLOWED_ORIGINS=
# Host header allowlist (DNS-rebinding guard). "name" allows any port, "name:port" one port.
# Empty = localhost, 127.0.0.1, [::1]
ALLOWED_HOSTS=
# Optional shared secret required as the x-api-token header on POST/PUT/PATCH/DELETE. Empty = off.
# If set, put the same value in frontend/.env as VITE_API_TOKEN. Note: VITE_ values are embedded
# in the JS bundle, so anyone who can load the dashboard can read it.
API_TOKEN=
